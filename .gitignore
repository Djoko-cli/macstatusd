.DS_Store
.build/
.swiftpm/
*.log

# Binaires compilés issus des sondes/prototypes de debug — le source suffit
# pour le versionning, le binaire se régénère avec swiftc.
backtest+debug/displaystate
backtest+debug/idleTime
backtest+debug/logstream-loginwindow
backtest+debug/macstatusd-debugv2
backtest+debug/macstatusd-debugv3
backtest+debug/macstatusd-debugv4
backtest+debug/probe
backtest+debug/testHybrid
backtest+debug/testLoginWindow
backtest+debug/test_display
backtest+debug/test_screensaver
macstatusd-debugv6

# config.json réel : contient webhook_base_url / auth_token de l'installation.
# config.example.json (versionné) sert de modèle.
config.json

# Dossier de travail local (audit détaillé, notes de session) : jamais commité.
.superpowers/

# Liste locale des valeurs réelles à ne jamais publier (lue par la garde pre-push,
# outils/pre-push) : jamais commitée.
garde.local.txt

# Schémas Archify (pages HTML locales) : jamais commités.
.archify/

# App assemblée par outils/assembler-app.sh (signature, équipe) : jamais commitée.
build/

# Bytecode Python des tests (porte des chemins absolus)
__pycache__/

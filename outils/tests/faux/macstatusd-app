#!/bin/bash
# Faux binaire d'app du banc : note ses arguments et imite --register / --unregister.
# Codes de la vraie app : 0 activé, 3 à autoriser, 4 non enregistré, 5 introuvable, 1 inconnu.
echo "$*" >> "$FAUX_JOURNAL/app.log"
echo "app $*" >> "$FAUX_JOURNAL/ordre.log"
if [[ "${1:-}" == "--register" ]]; then
  # Ce que l'app voit dans le dossier des journaux de la 0.5 au moment de l'enregistrement.
  { echo "--register"; ls -A "$HOME/Library/Logs/macstatusd" 2>/dev/null; } >> "$FAUX_JOURNAL/logs-vus.txt"
fi
case "${1:-}" in
  --register) code="${FAUX_APP_CODE:-0}" ;;
  --unregister) code="${FAUX_APP_UNREGISTER_CODE:-4}" ;;
  *) code=0 ;;
esac
if [[ "${1:-}" == "--register" && "$code" == "0" ]]; then
  # Un agent enregistré est chargé : le faux launchctl le trouve dans son fichier d'état.
  id="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$(dirname "$0")/../Info.plist" 2>/dev/null)"
  if [[ -n "$id" ]] && ! /usr/bin/grep -q -E "^$id( |\$)" "$FAUX_JOURNAL/charges" 2>/dev/null; then
    echo "$id $0" >> "$FAUX_JOURNAL/charges"
  fi
fi
case "$code" in
  0) echo "activé" ;;
  3) echo "à autoriser : Réglages Système > Général > Ouverture et extensions" ;;
  4) echo "non enregistré : lancer macstatusd --register" ;;
  5) echo "introuvable : l'app doit être dans ~/Applications ou /Applications" ;;
  *) echo "inconnu (code $code)" ;;
esac
exit "$code"
